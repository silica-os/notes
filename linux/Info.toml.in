# Notes as a Silica app bundle (silica-os docs/app-bundles.md): silica-packages and
# `cargo xtask os deploy` fill the placeholders and sign it. A system app: from /usr/Applications
# it runs without a sandbox; [permissions] is what a copy elsewhere is given.
format = 1
id = "dev.frascella.Notes"
name = "Notes"
"name.it" = "Note"
generic_name = "Notes"
comment = "Write notes, checklists and ideas"
version = "@VERSION@"
build = @BUILD@
minimum_silica = "0.2.0"
kind = "flutter"
runtime = "dev.silica.Platform//1"
args = ["--size", "1120x720", "--title", "Notes", "--multi-window"]
categories = ["Office", "Utility"]
keywords = ["notes", "checklist", "memo", "note", "appunti", "lista", "promemoria"]

[permissions]
network = false
devices = "gpu"

[developer]
name = "Silica"
key = "@DEVELOPER_KEY@"
